# Copiar este archivo como .env y ajustar los valores. El .env NO se sube al repositorio.

# --- Base de datos SQL Server ---
DB_SERVER=localhost
DB_NAME=TTDH_Automation
DB_DRIVER=ODBC Driver 17 for SQL Server
# yes = autenticación de Windows; no = usar DB_USER y DB_PASSWORD
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=

# --- Tesseract OCR (ruta del ejecutable en Windows) ---
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Frontend permitido (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Recepción de documentos (RF01) ---
# Rutas relativas a backend/. data/entrada/ está excluida del repositorio (.gitignore).
ALMACEN_DOCUMENTOS=../data/entrada/documentos
TAMANO_MAXIMO_MB=20
# Directorio donde el servidor SFTP deposita los archivos de la TGR.
SFTP_DIRECTORIO=../data/entrada/sftp
# Casilla de correo institucional (IMAP con SSL). Si IMAP_SERVIDOR está vacío, no se revisa el correo.
IMAP_SERVIDOR=
IMAP_PUERTO=993
IMAP_USUARIO=
IMAP_PASSWORD=
IMAP_CARPETA=INBOX
# Remitentes de la TGR autorizados, separados por coma (CU02 2a).
REMITENTES_AUTORIZADOS=

# Copiar este archivo como .env y ajustar los valores. El .env NO se sube al repositorio.

# --- Base de datos SQL Server ---
DB_SERVER=localhost
DB_NAME=TTDH_Automation
DB_DRIVER=ODBC Driver 17 for SQL Server
# yes = autenticación de Windows; no = usar DB_USER y DB_PASSWORD
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=

# --- Tesseract OCR (ruta del ejecutable en Windows) ---
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Frontend permitido (CORS) ---
FRONTEND_URL=http://localhost:5173

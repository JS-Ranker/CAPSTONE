    <connection>SQL_TTDH</connection>
    <sql>&#xd;&#xa;SELECT&#xd;&#xa;    nombre_documento AS &#x5b;NOMBRE DOCUMENTO&#x5d;,&#xd;&#xa;    rut AS &#x5b;RUT&#x5d;,&#xd;&#xa;    dv AS &#x5b;DV&#x5d;,&#xd;&#xa;    id_demanda AS &#x5b;ID DEMANDA&#x2a;&#x5d;,&#xd;&#xa;    n_resol AS &#x5b;N&#xb0; Resoluci&#xf3;n&#x5d;,&#xd;&#xa;    nom_cli AS &#x5b;NOMBRE CLIENTE&#x5d;,&#xd;&#xa;    monto_solicitado AS &#x5b;MONTO SOLICITADO&#x5d;,&#xd;&#xa;    saldo_menor_05_utm AS &#x5b;SALDO &#x3c; 0,5 UTM&#x5d;,&#xd;&#xa;    tipo_embargo AS &#x5b;TIPO EMBARGO&#x5d;,&#xd;&#xa;    rol AS &#x5b;EXPEDIENTE&#x5d;,&#xd;&#xa;    fec_ing AS &#x5b;FECHA INGRESO CASILLA&#x5d;,&#xd;&#xa;    tesoreria AS &#x5b;TESORERIA&#x5d;,&#xd;&#xa;    fecha_oficio AS &#x5b;FECHA OFICIO&#x5d;,&#xd;&#xa;    mult_rol AS &#x5b;MULTIPLES ROLES&#x5d;,&#xd;&#xa;    rev_manual AS &#x5b;REVISION MANUAL&#x5d;,&#xd;&#xa;    camp_falt AS &#x5b;CAMPOS FALTANTES OCR&#x5d;,&#xd;&#xa;    ent_banco AS &#x5b;ENTIDAD BANCARIA&#x5d;,&#xd;&#xa;    id_correo AS &#x5b;id_correo&#x5d;,&#xd;&#xa;    remit AS &#x5b;remitente&#x5d;,&#xd;&#xa;    asunto AS &#x5b;asunto&#x5d;,&#xd;&#xa;    ruta_doc AS &#x5b;RUTA DOCUMENTO&#x5d;&#xd;&#xa;FROM stg.casos_tgr&#x3b;&#xd;&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>

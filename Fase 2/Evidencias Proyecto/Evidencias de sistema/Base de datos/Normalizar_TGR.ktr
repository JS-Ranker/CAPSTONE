  <step>
    <name>Validar_RUT_DV</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>      <jsScript>        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>&#x2f;&#x2f;Script here&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#x2f;&#x2f; Normalizar el RUT&#xd;&#xa;var rut_limpio &#x3d; rut &#x3d;&#x3d; null &#x3f; &#x22;&#x22; &#x3a;&#xd;&#xa;    String&#x28;rut&#x29;.replace&#x28;&#x2f;&#x5b;.&#x5c;-&#x5c;s&#x5d;&#x2f;g, &#x22;&#x22;&#x29;&#x3b;&#xd;&#xa;&#xd;&#xa;&#x2f;&#x2f; Normalizar el DV&#xd;&#xa;var dv_limpio &#x3d; dv &#x3d;&#x3d; null &#x3f; &#x22;&#x22; &#x3a;&#xd;&#xa;    String&#x28;dv&#x29;.trim&#x28;&#x29;.toUpperCase&#x28;&#x29;&#x3b;&#xd;&#xa;&#xd;&#xa;&#x2f;&#x2f; Resultado de validaci&#xf3;n&#xd;&#xa;var rut_dv_valido &#x3d; &#x22;NO&#x22;&#x3b;&#xd;&#xa;&#xd;&#xa;&#x2f;&#x2f; Verificar formato y calcular d&#xed;gito verificador&#xd;&#xa;if &#x28;&#x2f;&#x5e;&#x5b;0-9&#x5d;&#x7b;7,9&#x7d;&#x24;&#x2f;.test&#x28;rut_limpio&#x29; &#x26;&#x26;&#xd;&#xa;    &#x2f;&#x5e;&#x5b;0-9K&#x5d;&#x24;&#x2f;.test&#x28;dv_limpio&#x29;&#x29; &#x7b;&#xd;&#xa;&#xd;&#xa;    var suma &#x3d; 0&#x3b;&#xd;&#xa;    var multiplicador &#x3d; 2&#x3b;&#xd;&#xa;&#xd;&#xa;    for &#x28;var i &#x3d; rut_limpio.length - 1&#x3b; i &#x3e;&#x3d; 0&#x3b; i--&#x29; &#x7b;&#xd;&#xa;        suma &#x2b;&#x3d; parseInt&#x28;rut_limpio.charAt&#x28;i&#x29;, 10&#x29;&#xd;&#xa;                &#x2a; multiplicador&#x3b;&#xd;&#xa;&#xd;&#xa;        multiplicador &#x3d; multiplicador &#x3d;&#x3d; 7&#xd;&#xa;            &#x3f; 2 &#x3a; multiplicador &#x2b; 1&#x3b;&#xd;&#xa;    &#x7d;&#xd;&#xa;&#xd;&#xa;    var resultado &#x3d; 11 - &#x28;suma &#x25; 11&#x29;&#x3b;&#xd;&#xa;&#xd;&#xa;    var dv_esperado &#x3d;&#xd;&#xa;        resultado &#x3d;&#x3d; 11 &#x3f; &#x22;0&#x22; &#x3a;&#xd;&#xa;        resultado &#x3d;&#x3d; 10 &#x3f; &#x22;K&#x22; &#x3a;&#xd;&#xa;        String&#x28;resultado&#x29;&#x3b;&#xd;&#xa;&#xd;&#xa;    if &#x28;dv_limpio &#x3d;&#x3d; dv_esperado&#x29; &#x7b;&#xd;&#xa;        rut_dv_valido &#x3d; &#x22;SI&#x22;&#x3b;&#xd;&#xa;    &#x7d;&#xd;&#xa;&#x7d;&#xd;&#xa;</jsScript_script>
      </jsScript>    </jsScripts>    <fields>      <field>        <name>rut_limpio</name>
        <rename>rut_limpio</rename>
        <type>String</type>
        <length>9</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>      <field>        <name>dv_limpio</name>
        <rename>dv_limpio</rename>
        <type>String</type>
        <length>1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>      <field>        <name>rut_dv_valido</name>
        <rename>rut_dv_valido</rename>
        <type>String</type>
        <length>2</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>    </fields>     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>619</xloc>

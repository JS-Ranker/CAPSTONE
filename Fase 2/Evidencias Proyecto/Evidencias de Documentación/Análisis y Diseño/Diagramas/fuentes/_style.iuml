!pragma layout smetana
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #3D4B5C
skinparam ActorBorderColor #2F5D8A
skinparam ActorBackgroundColor #DCE8F5
skinparam UsecaseBorderColor #2F5D8A
skinparam UsecaseBackgroundColor #F2F7FC
skinparam ComponentBorderColor #2F5D8A
skinparam ComponentBackgroundColor #F2F7FC
skinparam NodeBorderColor #3D4B5C
skinparam NodeBackgroundColor #F7F7F7
skinparam DatabaseBorderColor #2F5D8A
skinparam DatabaseBackgroundColor #F2F7FC
skinparam PackageBorderColor #8A9BB0
skinparam RectangleBorderColor #8A9BB0
skinparam ClassBorderColor #2F5D8A
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #DCE8F5
skinparam ActivityBorderColor #2F5D8A
skinparam ActivityBackgroundColor #F2F7FC
skinparam ActivityDiamondBorderColor #2F5D8A
skinparam ActivityDiamondBackgroundColor #FFF6E0
skinparam SequenceLifeLineBorderColor #8A9BB0
skinparam ParticipantBorderColor #2F5D8A
skinparam ParticipantBackgroundColor #F2F7FC
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #C9A227

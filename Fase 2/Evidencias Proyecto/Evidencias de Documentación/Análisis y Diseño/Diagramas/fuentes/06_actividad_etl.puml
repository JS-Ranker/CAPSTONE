@startuml
!include _style.iuml
title Diagrama de Actividad - Proceso ETL

start
:Recepción de documento TGR\n(correo, SFTP o carga web);
partition "Recepción y Extracción" {
  :Descargar adjunto y guardar\ndocumento original;
  :Registrar documento en Archivos_TGR;
  if (¿Formato estructurado?\n(Excel / CSV / TXT)) then (sí)
  else (no)
    if (¿PDF con texto?) then (sí)
      :Extraer tablas del PDF;
    else (no)
      :OCR + IA con visión\n(PDF escaneado o fotografía);
    endif
    :Mapear a plantilla estándar\ncon nivel de confianza;
    if (¿Confianza y totales OK? (RN05)) then (no)
      :Derivar a Bandeja de Excepciones\n(Revisión de Extracción);
      stop
    else (sí)
    endif
  endif
}
partition "Extract" {
  if (¿Cumple esquema y codificación? (RN04)) then (no)
    :Marcar archivo con estado Error;
    :Registrar en bitácora;
    stop
  else (sí)
  endif
  :Parsear encabezado, detalle y totales de control;
}
partition "Transform" {
  :Normalizar fechas y montos;
  while (¿Quedan registros?) is (sí)
    if (¿RUT válido Módulo 11? (RN01)) then (no)
      :Estado = Inválido (Error de Formato);
    elseif (¿Registro duplicado? (RN02)) then (sí)
      :Estado = Duplicado;
    elseif (¿Faltan campos obligatorios? (RN03)) then (sí)
      :Derivar a bandeja de Excepciones;
    else (no)
      :Estado = Válido;
    endif
  endwhile (no)
}
partition "Load" {
  :Insertar registros en Registros_TGR;
  :Activar Motor de Cruce con Core Bancario;
  :Actualizar estado del archivo = Procesado;
  :Registrar ejecución en bitácora;
}
stop
@enduml

@startuml
!include _style.iuml
autonumber
title Diagrama de Secuencia - Recepción y procesamiento de documento TGR (CU02, CU12, CU03, CU04)

actor "Analista de\nConciliación" as AN
participant "Frontend Web" as FE
participant "API Backend" as API
participant "Servidor de\nCorreo" as MAIL
participant "Módulo de\nRecepción" as REC
participant "Módulo de\nExtracción" as EXT
participant "Motor OCR\n(Tesseract)" as OCR
participant "Motor ETL" as ETL
participant "Motor de Cruce" as MAT
participant "Core Bancario" as CORE
participant "Módulo de IA" as IA
database "BD TTDH" as DB

alt Recepción automática por correo
  REC -> MAIL : Leer casilla institucional (programado)
  MAIL --> REC : Correos nuevos con adjuntos
  REC -> REC : Validar remitente y tipo de archivo
  REC -> DB : Registra Archivos_TGR\n(canal_origen = Correo, remitente, estado = Recibido)
else Carga manual vía web
  AN -> FE : Selecciona y sube archivo TGR
  FE -> API : POST /archivos (archivo)
  API -> REC : Registrar archivo
  REC -> DB : Registra Archivos_TGR\n(canal_origen = Web, estado = Recibido)
end

opt Documento PDF o imagen (CU12)
  REC -> EXT : Extraer y normalizar documento
  alt PDF con texto
    EXT -> EXT : Extraer tablas del PDF
  else PDF escaneado o fotografía
    EXT -> OCR : Procesar imagen preprocesada
    OCR --> EXT : Campos de cada registro + confianza
  end
  EXT -> EXT : Mapear a plantilla estándar y\ncomparar con totales de control (RN05)
  alt Confianza bajo el umbral o totales no cuadran
    EXT -> DB : Registros a Bandeja de Excepciones\n(Revisión de Extracción)
  end
  EXT -> DB : Actualiza Archivos_TGR\n(estado = Normalizado, confianza_extraccion)
end

REC -> ETL : Procesar archivo
ETL -> ETL : Validar formato de archivo (RN04)
alt Archivo no conforme
  ETL -> DB : Actualiza estado = Error
  ETL --> API : Rechazo de archivo
  API --> FE : Notifica error de formato
  FE --> AN : Muestra error de formato
else Archivo válido
  loop Por cada registro
    ETL -> ETL : Validar RUT Módulo 11 (RN01)
    ETL -> ETL : Controlar duplicidad (RN02)
    ETL -> ETL : Verificar campos obligatorios (RN03)
    ETL -> DB : Inserta Registros_TGR con estado_validacion
  end
  ETL -> MAT : Iniciar cruce de registros válidos
  MAT -> CORE : Consulta cuentas y estados de pago
  CORE --> MAT : Resultado de consulta
  MAT -> DB : Inserta Conciliacion_Banco
  MAT -> IA : Analizar resultados del lote
  IA -> DB : Inserta Analisis_IA_Anomalias
  MAT -> DB : Actualiza Archivos_TGR (estado = Procesado)
  MAT --> API : Lote procesado
  API -> DB : Registra Bitacora_Trazabilidad
  API --> FE : Resumen del lote procesado
  FE --> AN : Muestra resultados y alertas
end
@enduml
